# Server-side only. Never expose these in frontend code.
# Production AVA chat uses Cloudflare Workers AI binding (see wrangler.jsonc "ai").
# GEMINI_API_KEY is optional/legacy for local Express server only.
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM=OPERAVA <noreply@operavaglobal.com>
OTP_SECRET=
CLIENT_INBOX=hello@operavaglobal.com
TALENT_INBOX=talents@operavaglobal.com
# Optional: extra CC recipients for career applications (comma/semicolon separated)
APPLICANT_CC=
# Cloudflare Pages bindings (dashboard):
# AI = Workers AI (binding name "AI")
# D1 SUBMISSIONS_DB = operava-submissions
# R2 RESUMES_BUCKET = operava-resumes
