APPLICANT_CC=
CLIENT_INBOX=
GEMINI_API_KEY=
# REQUIRED for all OTP / signed drafts (forms + recruitment). Generate with:
#   openssl rand -hex 32
# Must be at least 32 characters. Never commit the real value.
# Without this, OTP endpoints return 503 OTP_SECRET_MISSING.
OTP_SECRET=
RESEND_API_KEY=
# Preferred From for all OTP/confirmation mail (Resend verified domain)
RESEND_EMAIL_FROM=OPERAVA <noreply@operavaglobal.com>
# Legacy alias (still read if RESEND_EMAIL_FROM is empty)
RESEND_FROM=OPERAVA <noreply@operavaglobal.com>
TALENT_INBOX=

# MEGA backup (Pages Function /api/mega-backup — preferred)
MEGA_EMAIL=
MEGA_PASSWORD=
BACKUP_SHARED_SECRET=
# Optional alias for the same shared secret:
MEGA_BACKUP_SECRET=

# Optional external Worker webhook (only if not using direct Pages MEGA_*):
MEGA_BACKUP_URL=
