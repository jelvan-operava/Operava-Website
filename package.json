{
  "name": "operava-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.17.1",
    "express": "^5.2.1",
    "framer-motion": "^13.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
