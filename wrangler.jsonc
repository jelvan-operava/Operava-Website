{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operava-website",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "SUBMISSIONS_DB",
      "database_name": "operava-submissions",
      "database_id": "249fe1d2-ce2c-4333-bd9c-1e0fa42ececa"
    }
  ],
  "vars": {
    "NODE_VERSION": "20",
    "RESEND_EMAIL_FROM": "OPERAVA <noreply@operavaglobal.com>",
    "RESEND_FROM": "OPERAVA <noreply@operavaglobal.com>",
    "CLIENT_INBOX": "hello@operavaglobal.com",
    "TALENT_INBOX": "talents@operavaglobal.com"
  }
}
