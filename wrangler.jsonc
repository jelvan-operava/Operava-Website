{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operava-website",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "RESUMES_BUCKET",
      "bucket_name": "operava-resumes"
    }
  ],
  "vars": {
    "NODE_VERSION": "20",
    "RESEND_FROM": "OPERAVA <noreply@operavaglobal.com>",
    "CLIENT_INBOX": "hello@operavaglobal.com",
    "SALES_INBOX": "hello@operavaglobal.com",
    "CS_INBOX": "cs@operavaglobal.com",
    "COMPLIANCE_INBOX": "compliance@operavaglobal.com",
    "TALENT_INBOX": "talents@operavaglobal.com",
    "HR_INBOX": "hr@operavaglobal.com"
  }
}
